<mujoco model="needle insertion scene">
  <!-- Franka Panda (torque controlled) holding an ultrasound probe -->
  <include file="panda_torque_needle.xml"/>

  <!-- 1 ms step = the 1 kHz control rate of the real Franka -->
  <option timestep="0.001" cone="elliptic"/>

  <statistic center="0.4 0 0.35" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.82 0.9" rgb2="0.25 0.3 0.4" width="512" height="3072"/>
    <texture type="2d" name="floor" builtin="checker" mark="edge" rgb1="0.75 0.78 0.8" rgb2="0.65 0.68 0.7"
      markrgb="0.9 0.9 0.9" width="300" height="300"/>
    <material name="floor" texture="floor" texuniform="true" texrepeat="4 4" reflectance="0.1"/>
    <material name="skin" rgba="0.87 0.68 0.56 1"/>
    <material name="sheet" rgba="0.55 0.75 0.8 1"/>
  </asset>

  <worldbody>
    <light pos="0.3 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor" contype="0" conaffinity="0"/>

    <!-- bed: purely visual -->
    <geom name="bed" type="box" pos="0.5 0 0.11" size="0.22 0.55 0.11" material="sheet" contype="0" conaffinity="0"/>

    <!-- patient (lying along world y, head at +y). Visual only: head, chest, legs -->
    <geom name="head"  type="sphere"    pos="0.5 0.47 0.30" size="0.085" material="skin" contype="0" conaffinity="0"/>
    <geom name="legs"  type="capsule"   fromto="0.5 -0.30 0.28 0.5 -0.52 0.27" size="0.085" material="sheet" contype="0" conaffinity="0"/>

    <!-- torso: moves up/down with breathing (joint "breath", driven by a stiff position servo,
         like the lead-screw breathing platform used in phantom experiments) -->
    <body name="torso" pos="0.5 0 0.22" gravcomp="1">
      <joint name="breath" type="slide" axis="0 0 1" range="-0.02 0.06" damping="0"/>
      <inertial pos="0 0 0" mass="20" diaginertia="1 1 1"/>
      <geom name="torso_vis" type="ellipsoid" pos="0 0.05 0.01" size="0.17 0.33 0.095" rgba="0.87 0.68 0.56 0.35" contype="0" conaffinity="0"/>

      <!-- soft tissue under the probe: a plate on a spring-damper (Kelvin-Voigt element).
           stiffness [N/m] and damping [N s/m] are set per subject from Python. -->
      <body name="skin" pos="0 0 0.10" gravcomp="1">
        <joint name="tissue" type="slide" axis="0 0 1" stiffness="1000" damping="20" range="-0.05 0.01"/>
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
        <geom name="skin_pad" type="box" pos="0 0 -0.006" size="0.11 0.14 0.006" rgba="0.93 0.74 0.62 0.35"
              contype="0" conaffinity="0" friction="0.1 0.005 0.0001"/>
      </body>
    </body>

    <!-- internal target (e.g. a liver lesion) that moves head-feet with breathing. Drawn only. -->
    <body name="target" mocap="true" pos="0.5 0 0.27">
      <geom type="sphere" size="0.005" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <!-- breathing servo: kp/kv high so the 20 kg torso follows the prescribed breathing curve -->
    <position name="breath_servo" joint="breath" kp="1000000" kv="20000" ctrlrange="-0.02 0.06"/>
  </actuator>

</mujoco>
